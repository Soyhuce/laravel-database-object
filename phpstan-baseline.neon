parameters:
	ignoreErrors:
		-
			message: '#^Instanceof between Illuminate\\Support\\Collection\<\(int\|string\), array\<mixed\>\>\|Illuminate\\Support\\Collection\<\(int\|string\), TDatabaseObject of Soyhuce\\DatabaseObject\\DatabaseObject\> and Illuminate\\Support\\Collection will always evaluate to true\.$#'
