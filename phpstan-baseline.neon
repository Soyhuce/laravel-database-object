			count: 1
			path: src/Casts/DatabaseObjectCollectionCast.php

		-
			message: '#^Call to an undefined static method TDateTime of DateTimeInterface\:\:createFromFormat\(\)\.$#'
			identifier: staticMethod.notFound
			count: 1
			path: src/DatabaseObject.php

		-
			message: '#^Method Soyhuce\\DatabaseObject\\DatabaseObject\:\:collectionClass\(\) return type with generic class Illuminate\\Support\\Collection does not specify its types\: TKey, TValue$#'
