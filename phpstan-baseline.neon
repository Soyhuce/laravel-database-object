		-
			message: '#^Method Soyhuce\\DatabaseObject\\Factory\\DatabaseObjectFactory\:\:newInstance\(\) should return static\(Soyhuce\\DatabaseObject\\Factory\\DatabaseObjectFactory\<TDatabaseObject of Soyhuce\\DatabaseObject\\DatabaseObject, TCollection of Illuminate\\Support\\Collection\>\) but returns static\(Soyhuce\\DatabaseObject\\Factory\\DatabaseObjectFactory\<Soyhuce\\DatabaseObject\\DatabaseObject, Illuminate\\Support\\Collection\>\)\.$#'
			identifier: return.type
