		-
			message: '#^Method Soyhuce\\DatabaseObject\\Factory\\DatabaseObjectFactory\:\:createOne\(\) should return TDatabaseObject of Soyhuce\\DatabaseObject\\DatabaseObject but returns Illuminate\\Support\\Collection\<int, TDatabaseObject of Soyhuce\\DatabaseObject\\DatabaseObject\>\|TDatabaseObject of Soyhuce\\DatabaseObject\\DatabaseObject\.$#'
